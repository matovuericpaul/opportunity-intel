# --- Required ---

# OpenRouter API key — powers scoring, proposal advice, and live opportunity search.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend API key — sends the deadline digest emails.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where the daily digest (and test digests) should be sent.
ALERT_EMAIL=you@example.com

# A password you invent yourself. Required to trigger "Send test digest now" from the
# browser, so a stranger who finds your site can't spam your inbox with test emails.
DIGEST_SECRET=choose-a-long-random-string

# --- Optional (sensible defaults are baked in) ---

# Verified sending address in Resend. If you haven't verified a domain yet, Resend's
# shared 'resend.dev' sender works for testing.
# DIGEST_FROM_EMAIL="Opportunity Digest <digest@resend.dev>"

# Models used for each AI feature (OpenRouter model slugs).
# OPENROUTER_MODEL_SCORING=anthropic/claude-sonnet-4.5
# OPENROUTER_MODEL_ADVICE=anthropic/claude-sonnet-4.5

# Model used for live web-search opportunity discovery. Must be a model OpenRouter
# supports with the ':online' suffix (web-search grounding), e.g. perplexity/sonar-pro:online
# or openai/gpt-4o:online.
# OPENROUTER_MODEL_ONLINE=perplexity/sonar-pro:online

# Used only for the HTTP-Referer header OpenRouter asks for — cosmetic, not required to match.
# PUBLIC_SITE_URL=https://your-site.netlify.app
